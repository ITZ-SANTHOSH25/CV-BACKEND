'use strict';

const express = require('express');
const cors = require('cors');
const fs = require('fs');
const path = require('path');
const Database = require('better-sqlite3');

const app = express();

app.disable('x-powered-by');

app.use(cors({
    origin: true,
    methods: ['GET', 'POST', 'PUT', 'PATCH', 'DELETE', 'OPTIONS'],
    allowedHeaders: ['Content-Type', 'Authorization']
}));

app.use(express.json({ limit: '1mb' }));

// --------------------------------------------------
// DATABASE SETUP
// --------------------------------------------------

const dbPath =
    process.env.DB_PATH ||
    path.join(__dirname, 'data', 'carvanta.db');

fs.mkdirSync(path.dirname(dbPath), {
    recursive: true
});

const db = new Database(dbPath);

db.pragma('journal_mode = WAL');
db.pragma('foreign_keys = ON');
db.pragma('busy_timeout = 5000');

db.exec(`
    CREATE TABLE IF NOT EXISTS contacts (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        name TEXT NOT NULL,
        phone TEXT NOT NULL UNIQUE,
        relation TEXT NOT NULL DEFAULT 'Neighbourhood',
        type TEXT NOT NULL DEFAULT '',
        created_at TEXT NOT NULL,
        updated_at TEXT NOT NULL
    );

    CREATE TABLE IF NOT EXISTS alerts (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        reason TEXT NOT NULL,
        location TEXT NOT NULL DEFAULT '',
        status TEXT NOT NULL DEFAULT 'active',
        created_at TEXT NOT NULL,
        updated_at TEXT NOT NULL
    );

    CREATE TABLE IF NOT EXISTS alert_recipients (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        alert_id INTEGER NOT NULL
            REFERENCES alerts(id) ON DELETE CASCADE,
        contact_id INTEGER,
        name TEXT NOT NULL,
        phone TEXT NOT NULL,
        relation TEXT NOT NULL DEFAULT 'Neighbourhood',
        status TEXT NOT NULL DEFAULT 'pending',
        response TEXT,
        responded_at TEXT,
        created_at TEXT NOT NULL
    );

    CREATE INDEX IF NOT EXISTS idx_alert_recipients_alert
        ON alert_recipients(alert_id);

    CREATE INDEX IF NOT EXISTS idx_alert_status
        ON alerts(status);

    CREATE TABLE IF NOT EXISTS activity_logs (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        type TEXT NOT NULL DEFAULT 'System',
        message TEXT NOT NULL,
        detail TEXT NOT NULL DEFAULT '',
        status TEXT NOT NULL DEFAULT 'ok',
        time TEXT NOT NULL
    );
`);

// --------------------------------------------------
// COMMON FUNCTIONS
// --------------------------------------------------

const now = () => new Date().toISOString();

function cleanContact(row) {
    return {
        id: row.id,
        name: row.name,
        phone: row.phone,
        relation: row.relation,
        type: row.type,
        createdAt: row.created_at,
        updatedAt: row.updated_at
    };
}

function addLog(
    type,
    message,
    detail = '',
    status = 'ok',
    time = now()
) {
    db.prepare(`
        INSERT INTO activity_logs
            (type, message, detail, status, time)
        VALUES (?, ?, ?, ?, ?)
    `).run(type, message, detail, status, time);
}

function getAlert(id) {
    const alert = db.prepare(`
        SELECT *
        FROM alerts
        WHERE id = ?
    `).get(Number(id));

    if (!alert) {
        return null;
    }

    const recipients = db.prepare(`
        SELECT *
        FROM alert_recipients
        WHERE alert_id = ?
        ORDER BY id
    `).all(alert.id).map(row => ({
        id: row.id,
        contactId: row.contact_id,
        name: row.name,
        phone: row.phone,
        relation: row.relation,
        status: row.status,
        response: row.response,
        respondedAt: row.responded_at
    }));

    return {
        id: alert.id,
        reason: alert.reason,
        location: alert.location,
        status: alert.status,
        createdAt: alert.created_at,
        updatedAt: alert.updated_at,
        recipients
    };
}

function validId(value) {
    const id = Number(value);

    return Number.isSafeInteger(id) && id > 0
        ? id
        : null;
}

function validPhone(phone) {
    return /^[+0-9()\-\s]{7,20}$/.test(phone);
}

function sendError(res, status, message) {
    return res.status(status).json({
        ok: false,
        message
    });
}

