// --------------------------------------------------
// CONTACTS: REGISTER
// --------------------------------------------------

app.post('/api/contacts', (req, res) => {
    const name = String(req.body.name || '').trim();

    const phone = String(
        req.body.phone || req.body.mobile || ''
    ).trim();

    const relation = String(
        req.body.relation ||
        req.body.relationship ||
        'Neighbourhood'
    ).trim();

    const type = String(req.body.type || '').trim();

    if (!name || !phone) {
        return sendError(
            res,
            400,
            'Name and phone number are required.'
        );
    }

    if (!validPhone(phone)) {
        return sendError(
            res,
            400,
            'Enter a valid phone number.'
        );
    }

    const time = now();

    try {
        const result = db.prepare(`
            INSERT INTO contacts
                (name, phone, relation, type, created_at, updated_at)
            VALUES (?, ?, ?, ?, ?, ?)
        `).run(
            name,
            phone,
            relation,
            type,
            time,
            time
        );

        const contact = cleanContact(
            db.prepare(`
                SELECT *
                FROM contacts
                WHERE id = ?
            `).get(Number(result.lastInsertRowid))
        );

        addLog(
            'System',
            'Emergency contact added',
            `${name} · ${phone} · ${relation}`
        );

        res.status(201).json({
            ok: true,
            message: 'Contact registered successfully.',
            contact
        });
    } catch (error) {
        if (String(error.code || '').includes('SQLITE_CONSTRAINT')) {
            return sendError(
                res,
                409,
                'This phone number is already registered.'
            );
        }

        console.error('Register contact failed:', error.message);

        sendError(res, 500, 'Unable to register contact.');
    }
});

