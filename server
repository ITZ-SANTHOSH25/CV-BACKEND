// --------------------------------------------------
// ALERTS: CREATE EMERGENCY ALERT
// --------------------------------------------------

app.post('/api/alerts', (req, res) => {
    const reason = String(
        req.body.reason || 'Emergency alert'
    ).trim();

    const location = String(
        req.body.location || ''
    ).trim();

    let supplied = Array.isArray(req.body.recipients)
        ? req.body.recipients.filter(row =>
            row &&
            String(row.name || '').trim() &&
            String(row.phone || '').trim()
        )
        : [];

    // If recipients are not supplied, use registered contacts.
    if (supplied.length === 0) {
        supplied = db.prepare(`
            SELECT id, name, phone, relation
            FROM contacts
            ORDER BY id DESC
        `).all();
    }

    if (supplied.length === 0) {
        return sendError(
            res,
            400,
            'No emergency contacts found. Register a contact first.'
        );
    }

    // Validate all recipients before creating the alert.
    for (const recipient of supplied) {
        const name = String(recipient.name || '').trim();
        const phone = String(recipient.phone || '').trim();

        if (!name || !validPhone(phone)) {
            return sendError(
                res,
                400,
                'One or more recipients have invalid details.'
            );
        }
    }

    const createdAt =
        req.body.createdAt &&
        !Number.isNaN(Date.parse(req.body.createdAt))
            ? new Date(req.body.createdAt).toISOString()
            : now();

    try {
        const createAlert = db.transaction(() => {
            const result = db.prepare(`
                INSERT INTO alerts
                    (reason, location, status, created_at, updated_at)
                VALUES (?, ?, 'active', ?, ?)
            `).run(
                reason,
                location,
                createdAt,
                createdAt
            );

            const alertId = Number(result.lastInsertRowid);

            const insertRecipient = db.prepare(`
                INSERT INTO alert_recipients
                    (
                        alert_id,
                        contact_id,
                        name,
                        phone,
                        relation,
                        status,
                        created_at
                    )
                VALUES (?, ?, ?, ?, ?, 'pending', ?)
            `);

            for (const recipient of supplied) {
                const possibleId = Number(recipient.id);

                const contact =
                    Number.isSafeInteger(possibleId) &&
                    possibleId > 0
                        ? db.prepare(`
                            SELECT id
                            FROM contacts
                            WHERE id = ?
                        `).get(possibleId)
                        : null;

                insertRecipient.run(
                    alertId,
                    contact ? contact.id : null,
                    String(recipient.name).trim(),
                    String(recipient.phone).trim(),
                    String(
                        recipient.relation || 'Neighbourhood'
                    ).trim(),
                    createdAt
                );
            }

            const recipientCount = db.prepare(`
                SELECT COUNT(*) AS count
                FROM alert_recipients
                WHERE alert_id = ?
            `).get(alertId).count;

            if (recipientCount === 0) {
                throw new Error('No valid recipients saved.');
            }

            addLog(
                'Alert',
                `Emergency alert sent to ${recipientCount} contacts`,
                `${reason} · ${location} · Alert ID: ${alertId}`,
                'alert',
                createdAt
            );

            return alertId;
        });

        const alertId = createAlert();

        res.status(201).json({
            ok: true,
            message: 'Emergency alert created successfully.',
            alert: getAlert(alertId)
        });
    } catch (error) {
        console.error('Create alert failed:', error.message);

        sendError(res, 500, 'Unable to create emergency alert.');
    }
});

// --------------------------------------------------
// RECIPIENT: ACKNOWLEDGE OR DECLINE
// --------------------------------------------------

app.post(
    '/api/alerts/:id/recipients/:contactId/respond',
    (req, res) => {
        const alertId = validId(req.params.id);
        const recipientId = validId(req.params.contactId);

        if (!alertId || !recipientId) {
            return sendError(
                res,
                400,
                'Invalid alert or recipient ID.'
            );
        }

        const response = String(
            req.body.response || req.body.status || ''
        ).toLowerCase();

        if (!['acknowledged', 'declined'].includes(response)) {
            return sendError(
                res,
                400,
                'Response must be acknowledged or declined.'
            );
        }

        try {
            const processResponse = db.transaction(() => {
                const alert = db.prepare(`
                    SELECT *
                    FROM alerts
                    WHERE id = ?
                `).get(alertId);

                if (!alert) {
                    return {
                        error: 404,
                        message: 'Alert not found.'
                    };
                }

                // IMPORTANT:
                // Prefer the alert recipient row ID.
                // Only fall back to the contact ID if no row matches.
                let recipient = db.prepare(`
                    SELECT *
                    FROM alert_recipients
                    WHERE alert_id = ?
                      AND id = ?
                `).get(alertId, recipientId);

                if (!recipient) {
                    recipient = db.prepare(`
                        SELECT *
                        FROM alert_recipients
                        WHERE alert_id = ?
                          AND contact_id = ?
                        ORDER BY id
                        LIMIT 1
                    `).get(alertId, recipientId);
                }

                if (!recipient) {
                    return {
                        error: 404,
                        message: 'Recipient not found for this alert.'
                    };
                }

                if (
                    ['resolved', 'cancelled', 'ended']
                        .includes(alert.status)
                ) {
                    return {
                        error: 409,
                        message: 'This alert has already been closed.'
                    };
                }

                if (
                    ['acknowledged', 'declined']
                        .includes(recipient.status)
                ) {
                    return {
                        alreadyResponded: true,
                        recipient,
                        alertId
                    };
                }

                const respondedAt = now();

                db.prepare(`
                    UPDATE alert_recipients
                    SET status = ?,
                        response = ?,
                        responded_at = ?
                    WHERE id = ?
                `).run(
                    response,
                    response,
                    respondedAt,
                    recipient.id
                );

                addLog(
                    'Acknowledgement',
                    `${recipient.name} ${response} emergency alert`,
                    `Alert ID: ${alertId} · ${recipient.phone} · ${respondedAt}`,
                    response === 'acknowledged' ? 'ok' : 'warn',
                    respondedAt
                );

                const pending = db.prepare(`
                    SELECT COUNT(*) AS count
                    FROM alert_recipients
                    WHERE alert_id = ?
                      AND status NOT IN (
                          'acknowledged',
                          'declined'
                      )
                `).get(alertId).count;

                if (pending === 0) {
                    db.prepare(`
                        UPDATE alerts
                        SET status = 'resolved',
                            updated_at = ?
                        WHERE id = ?
                    `).run(now(), alertId);
                }

                return {
                    success: true,
                    alertId,
                    recipientId: recipient.id,
                    response,
                    respondedAt
                };
            });

            const result = processResponse();

            if (result.error) {
                return sendError(
                    res,
                    result.error,
                    result.message
                );
            }

            if (result.alreadyResponded) {
                return res.json({
                    ok: true,
                    message: 'This recipient already responded.',
                    alert: getAlert(result.alertId)
                });
            }

            res.json({
                ok: true,
                message: `Alert ${result.response} successfully.`,
                recipient: {
                    id: result.recipientId,
                    status: result.response,
                    respondedAt: result.respondedAt
                },
                alert: getAlert(result.alertId)
            });
        } catch (error) {
            console.error('Alert response failed:', error.message);

            sendError(
                res,
                500,
                'Unable to save the alert response.'
            );
        }
    }
);

// --------------------------------------------------
// DEVICE-LEVEL ACKNOWLEDGEMENT
// --------------------------------------------------

app.post('/api/alerts/:id/acknowledge', (req, res) => {
    const alertId = validId(req.params.id);

    if (!alertId) {
        return sendError(res, 400, 'Invalid alert ID.');
    }

    try {
        const alert = db.prepare(`
            SELECT *
            FROM alerts
            WHERE id = ?
        `).get(alertId);

        if (!alert) {
            return sendError(res, 404, 'Alert not found.');
        }

        if (
            ['resolved', 'cancelled', 'ended']
                .includes(alert.status)
        ) {
            return res.json({
                ok: true,
                alertId,
                status: alert.status,
                message: 'This alert has already been closed.'
            });
        }

        const acknowledgedAt = now();

        db.prepare(`
            UPDATE alerts
            SET status = 'resolved',
                updated_at = ?
            WHERE id = ?
        `).run(acknowledgedAt, alertId);

        addLog(
            'Acknowledgement',
            'Emergency alert acknowledged on dashboard',
            `Alert ID: ${alertId} · By: ${
                String(req.body.acknowledgedBy || 'dashboard-device')
            } · ${acknowledgedAt}`,
            'ok',
            acknowledgedAt
        );

        res.json({
            ok: true,
            alertId,
            status: 'acknowledged',
            acknowledgedAt,
            message: 'Emergency alert acknowledged successfully.'
        });
    } catch (error) {
        console.error('Device acknowledge failed:', error.message);

        sendError(res, 500, 'Unable to acknowledge alert.');
    }
});

