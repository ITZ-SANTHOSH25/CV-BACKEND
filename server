});

function shutdown() {
    console.log('Shutting down CARVANTA API...');

    server.close(() => {
        try {
            db.close();
        } finally {
            process.exit(0);
        }
    });
}

process.on('SIGTERM', shutdown);
process.on('SIGINT', shutdown);
