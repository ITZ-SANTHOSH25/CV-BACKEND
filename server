        `).all(limit).map(row => ({
            id: row.id,
            type: row.type,
            message: row.message,
            detail: row.detail,
            status: row.status,
            time: row.time
        }));

        res.json({
            ok: true,
            logs
        });
    } catch (error) {
        console.error('Get logs failed:', error.message);

        sendError(res, 500, 'Unable to load activity logs.');
    }
});

