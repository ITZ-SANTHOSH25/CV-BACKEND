app.put('/api/contacts/:id', (req, res) => {
    const id = validId(req.params.id);

    if (!id) {
        return sendError(res, 400, 'Invalid contact ID.');
    }

    const old = db.prepare(`
        SELECT *
        FROM contacts
        WHERE id = ?
    `).get(id);

    if (!old) {
        return sendError(res, 404, 'Contact not found.');
    }

    const name = String(
        req.body.name ?? old.name
    ).trim();

    const phone = String(
        req.body.phone ?? old.phone
    ).trim();

    const relation = String(
        req.body.relation ??
        req.body.relationship ??
        old.relation
    ).trim();

    const type = String(
        req.body.type ?? old.type
    ).trim();

    if (!name || !phone) {
        return sendError(
            res,
            400,
            'Name and phone number are required.'
        );
    }

    if (!validPhone(phone)) {
        return sendError(
            res,
            400,
            'Enter a valid phone number.'
        );
    }

    try {
        db.prepare(`
            UPDATE contacts
            SET name = ?,
                phone = ?,
                relation = ?,
                type = ?,
                updated_at = ?
            WHERE id = ?
        `).run(
            name,
            phone,
            relation,
            type,
            now(),
            id
        );

        const contact = cleanContact(
            db.prepare(`
                SELECT *
                FROM contacts
                WHERE id = ?
            `).get(id)
        );

        addLog(
            'System',
            'Emergency contact updated',
            `${name} · ${phone}`
        );

        res.json({
            ok: true,
            message: 'Contact updated successfully.',
            contact
        });
    } catch (error) {
        if (String(error.code || '').includes('SQLITE_CONSTRAINT')) {
            return sendError(
                res,
                409,
                'This phone number is already registered.'
            );
        }

        console.error('Update contact failed:', error.message);

        sendError(res, 500, 'Unable to update contact.');
    }
});

